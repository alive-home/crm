# The Hono API port. `bun run dev` sets this itself; it only needs to be here if you run the two
# processes by hand. It must be the Vite port plus 1000, because that is where the dev proxy sends
# /api, /login and /logout.
API_PORT=4594

# The CRM database. Both are required and neither has a default in code: a default is what lets a
# misconfigured environment boot cleanly against the wrong database and look like it lost its data.
# The URL is ordinary config. The token is a rotating secret — set it as a platform secret in
# production (`fly secrets set TURSO_API_KEY_CRM=...`), never in a committed file.
#
# A brand new database has no tables. Run `bun scripts/migrate.ts` once against it. That is also the
# command that upgrades an existing one; it only ever adds.
TURSO_DATABASE_URL_CRM=libsql://<your-database>.turso.io
TURSO_API_KEY_CRM=

# The Alive services host (discovery, stealth fetch, AI extract, KvK).
ALIVE_SERVICES_URL=https://services.example.com

# ALIVE_SECRET_KEY is generated into .env.development by the platform and is deliberately the one
# secret that stays in a file: it is what buys access to the services, so it cannot come from them.

# Which addresses are ours, for scripts/mail-sync.ts: it decides whether a message is inbound.
# Comma-separated addresses or @domain suffixes. No default — an empty pattern would silently mark
# every message as incoming and pick the counterpart from our own side.
OUR_ADDRESSES=me@example.com,@mycompany.com
