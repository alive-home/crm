{
  "name": "crm",
  "private": true,
  "version": "1.0.0",
  "license": "MIT",
  "description": "A single-tenant CRM: one React app over one Hono router over one hosted SQLite database.",
  "repository": "github:alive-home/crm",
  "type": "module",
  "engines": {
    "bun": ">=1.2.0"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "trap 'kill 0' EXIT; bun run dev:api & bun run dev:web",
    "dev:web": "PORT=3594 vite",
    "dev:api": "API_PORT=4594 bun --watch server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "serve": "NODE_ENV=production bun run server.ts",
    "check": "bun run lint && bun run typecheck",
    "check:fix": "biome check --write .",
    "lint": "biome check . && bun run lint:file-length && bun run lint:runtime-imports",
    "lint:file-length": "scripts/check-file-length.sh",
    "lint:runtime-imports": "scripts/check-runtime-imports.sh",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@libsql/client": "^0.17.4",
    "@maplibre/maplibre-gl-style-spec": "^26.2.1",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.96.2",
    "@tanstack/react-router": "^1.168.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "hono": "^4.12.12",
    "lucide-react": "^1.7.0",
    "maplibre-gl": "^6.3.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@alive-game/alive-tagger": "0.2.1",
    "@biomejs/biome": "^2.4.10",
    "@tailwindcss/vite": "^4.2.2",
    "@types/bun": "^1.3.14",
    "@types/node": "^22.16.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react-swc": "^4.0.0",
    "tailwindcss": "^4.2.2",
    "typescript": "7.0.2",
    "vite": "^8.0.7"
  }
}
